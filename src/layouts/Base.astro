---
import '@fontsource-variable/bricolage-grotesque/wght.css';
import '@fontsource-variable/inter';
import '../styles/global.css';
import site from '../content/site.json';

interface Props { title?: string; description?: string; noindex?: boolean }
const { title = site.meta.title, description = site.meta.description, noindex = false } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = new URL(Astro.url.pathname, site.meta.url).href;
const ogImage = new URL(site.meta.ogImage, site.meta.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.person.name,
  alternateName: site.person.alias,
  jobTitle: site.person.role,
  url: site.meta.url,
  image: ogImage,
  email: `mailto:${site.person.emailUser}@${site.person.emailDomain}`,
  sameAs: site.socials.map((s) => s.url),
};
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="google-site-verification" content={site.meta.googleVerification} />
    <meta name="theme-color" content="#fbf8f3" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content="Kajetano" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Kajetano – Kajetan Pilachowski, marketing w social mediach" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}favicon-32.png`} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#tresc">Przejdź do treści</a>
    <slot />
  </body>
</html>
