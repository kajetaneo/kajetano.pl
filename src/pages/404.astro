---
import Base from '../layouts/Base.astro';
const home = import.meta.env.BASE_URL;
---
<Base title="Nie ma takiej strony – Kajetano" noindex>
  <main id="tresc" class="notfound">
    <a class="wordmark" href={home}>kajetano<span>.</span></a>
    <h1>Tu nic nie ma.</h1>
    <p>Ta strona odleciała, pewnie tanimi liniami do Azji. Wróć na start i zobacz, co robię.</p>
    <a class="btn btn--accent" href={home}>Strona główna <span class="arrow" aria-hidden="true">→</span></a>
  </main>
</Base>
<style>
  .notfound { min-height: 100svh; padding: var(--m); display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: 28px; }
  .notfound .wordmark { position: absolute; top: 20px; }
  .notfound h1 { font-size: var(--t-xl); }
  .notfound p { max-width: 36ch; }
</style>
